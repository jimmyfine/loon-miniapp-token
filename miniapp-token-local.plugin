#!name = 小程序 Token 提取（本地）
#!desc = 读取已 MITM 的接口响应与请求头，发现 token 后保存并发送 Loon 通知，不改写流量
#!author = Qoder
#!date = 2026-11-09
#!tag = 工具
#!system = iOS,iPadOS

[Argument]
# 小程序业务接口域名，多个用英文逗号分隔，支持 *.example.com；* 表示不限制
hostAllowlist = input,"*",type=string,tag=接口域名,desc=多个域名用英文逗号分隔，* 表示不限制
debug = switch,false,type=boolean,tag=调试日志

[Script]
http-response ^https?:// script-path=miniapp-token.js, requires-body=true, binary-body-mode=true, timeout=10, argument=[{hostAllowlist},{debug}], tag=小程序 Token

# 把 api.example.com 换成小程序实际接口域名；只添加业务接口域名
[Mitm]
hostname = %APPEND% api.example.com
