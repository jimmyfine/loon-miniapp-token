#!name = 小程序 Token 提取
#!desc = 读取已 MITM 的接口响应与请求头，发现 token 后保存并发送 Loon 通知，不改写流量
#!author = Qoder
#!date = 2026-11-09
#!tag = 工具
#!system = iOS,iPadOS

[Script]
http-response ^https?:// script-path=https://cdn.jsdelivr.net/gh/jimmyfine/loon-miniapp-token@main/miniapp-token.js, requires-body=true, binary-body-mode=false, timeout=10, tag=小程序 Token

# 也可以在 Loon 配置的 [Mitm] hostname 中追加实际接口域名，无需修改本插件
# 如需在此处指定，把 api.example.com 换成实际域名，多个用英文逗号分隔，支持 *.example.com
[Mitm]
hostname = %APPEND% api.example.com
